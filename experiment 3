import heapq

graph = {
    'A': [('B', 1), ('C', 4)],
    'B': [('D', 2)],
    'C': [('D', 1)],
    'D': []
}

def ucs(start, goal):
    q = [(0, start)]
    while q:
        cost, node = heapq.heappop(q)
        if node == goal:
            print("Minimum cost:", cost)
            return
        for n, c in graph[node]:
            heapq.heappush(q, (cost+c, n))

ucs('A', 'D')
